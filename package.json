    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
