# Base PostgreSQL. Sans valeur, une base embarquee est creee dans ./data/pglite
DATABASE_URL=
# URL publique de l'application (liens dans les e-mails)
APP_URL=http://localhost:3000
# Secret de signature des webhooks de paiement
BILLING_WEBHOOK_SECRET=change-moi
# Secret de chiffrement des donnees sensibles (cles de double authentification).
# Obligatoire en production ; ne jamais le changer une fois des comptes proteges.
APP_SECRET=
# Double authentification exigee pour l'administration (1 ou 0). Par defaut : exigee en production.
REQUIRE_ADMIN_2FA=
# Prestataires (vides = simulation locale)
# E-mails : outbox (boite d'envoi locale), brevo, postmark ou resend
MAIL_PROVIDER=outbox
MAIL_API_KEY=
# Expediteur, sur un domaine authentifie (SPF, DKIM, DMARC) chez le prestataire
MAIL_FROM=Pilot-Makers <devis@exemple.fr>
# Cle du suivi des rejets : /api/mail/webhook/<prestataire>?cle=<valeur>
MAIL_WEBHOOK_SECRET=
BILLING_PROVIDER=simulated
ASSISTANT_PROVIDER=local
# E-mail de l'administrateur de la plateforme (recoit le role admin a l'inscription)
PLATFORM_ADMIN_EMAILS=
# Secret des taches planifiees (relances, maintenance) : en-tete Authorization: Bearer <secret>
CRON_SECRET=change-moi
# Demonstration uniquement : la page /boite-de-test affiche les e-mails de n'importe quelle adresse
DEMO_OUTBOX=
