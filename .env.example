# Base PostgreSQL. Sans valeur, une base embarquee est creee dans ./data/pglite
DATABASE_URL=
# URL publique de l'application (liens dans les e-mails)
APP_URL=http://localhost:3000
# Secret de signature des webhooks de paiement
BILLING_WEBHOOK_SECRET=change-moi
# Secret de chiffrement des donnees sensibles (cles de double authentification).
# Obligatoire en production ; ne jamais le changer une fois des comptes proteges.
APP_SECRET=
# Double authentification exigee pour l'administration (1 ou 0). Par defaut : exigee en production.
REQUIRE_ADMIN_2FA=
# Prestataires (vides = simulation locale)
# E-mails : outbox (boite d'envoi locale), brevo, postmark ou resend
MAIL_PROVIDER=outbox
MAIL_API_KEY=
# Expediteur, sur un domaine authentifie (SPF, DKIM, DMARC) chez le prestataire
MAIL_FROM=Pilot-Makers <devis@exemple.fr>
# Cle du suivi des rejets : /api/mail/webhook/<prestataire>?cle=<valeur>
MAIL_WEBHOOK_SECRET=
BILLING_PROVIDER=simulated
ASSISTANT_PROVIDER=local
# E-mail de l'administrateur de la plateforme (recoit le role admin a l'inscription)
PLATFORM_ADMIN_EMAILS=
# Secret des taches planifiees (relances, maintenance) : en-tete Authorization: Bearer <secret>
CRON_SECRET=change-moi
# Demonstration uniquement : la page /boite-de-test affiche les e-mails de n'importe quelle adresse
DEMO_OUTBOX=
# Demonstration uniquement : la maintenance quotidienne remet le compte de demonstration a zero
DEMO_RESET=

# Adresse de signalement des failles (page /securite et /.well-known/security.txt) ; a defaut LEGAL_EMAIL
SECURITY_EMAIL=

# Mentions légales (page /mentions-legales)
LEGAL_COMPANY_FORM=
LEGAL_ADDRESS=
LEGAL_SIRET=
LEGAL_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=

# Surveillance : alertes d'erreurs vers un canal d'équipe et détail de /api/health
ALERT_WEBHOOK_URL=
HEALTH_TOKEN=

# Géocodage des adresses de chantier (service public de la Géoplateforme, sans clé). GEOCODER=off pour le désactiver.
GEOCODER=
GEOCODER_URL=
# Prévisions météo des chantiers extérieurs (Open-Meteo, sans clé). WEATHER=off pour les désactiver, WEATHER=demo pour une prévision fictive.
WEATHER=
WEATHER_URL=

# Stockage des fichiers : en base par défaut. STORAGE_DRIVER=s3 pour un stockage objet compatible S3
# (Scaleway, OVHcloud, Clever Cloud, AWS, MinIO). Les fichiers se lisent par des liens signés à durée limitée.
STORAGE_DRIVER=
S3_HOST=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 pour les adresses de la forme hôte/bucket/fichier (MinIO) ; S3_PROTOCOL=http pour un service local
S3_PATH_STYLE=
S3_PROTOCOL=
