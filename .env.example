# Base PostgreSQL. Sans valeur, une base embarquee est creee dans ./data/pglite
DATABASE_URL=
# URL publique de l'application (liens dans les e-mails)
APP_URL=http://localhost:3000
# Secret de signature des webhooks de paiement
BILLING_WEBHOOK_SECRET=change-moi
# Prestataires (vides = simulation locale)
MAIL_PROVIDER=outbox
BILLING_PROVIDER=simulated
AI_PROVIDER=local
# E-mail de l'administrateur de la plateforme (recoit le role admin a l'inscription)
PLATFORM_ADMIN_EMAILS=
